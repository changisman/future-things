# 이 파일을 .env 로 복사한 뒤 키를 넣으세요.

# ▶ 가장 간단한 방법: Gemini 키 하나만 넣으면 챗봇과 그림 모두 Gemini로 동작합니다.
#   발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (선택) Claude 챗봇이나 OpenAI 그림을 쓰고 싶을 때
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# (선택) 둘 다 있을 때 무엇을 쓸지 지정
# CHAT_PROVIDER=gemini     # 또는 claude
# IMAGE_PROVIDER=svg       # svg(무료, 단순한 그림) · gemini · openai

# (선택) 모델 이름
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# CLAUDE_MODEL=claude-opus-5-5
# OPENAI_IMAGE_MODEL=gpt-image-1
# PORT=3000

# (선택) 반 비밀번호, 작품 저장 데이터베이스(Neon 등)
# CLASS_PASSWORD=
# DATABASE_URL=
